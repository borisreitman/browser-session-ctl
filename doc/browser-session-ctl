#!/usr/bin/env bash
# Example wrapper. Copy to ~/bin and edit DEFAULT_ROOT to your clone:
#   cp doc/browser-session-ctl ~/bin/browser-session-ctl
#   chmod +x ~/bin/browser-session-ctl
set -euo pipefail

DEFAULT_ROOT="$HOME/src/browser-session-ctl"

resolve_root() {
  if [[ -n "${BROWSER_SESSION_CTL_ROOT:-}" ]]; then
    printf '%s\n' "$BROWSER_SESSION_CTL_ROOT"
    return
  fi

  local source="${BASH_SOURCE[0]}"
  local dir
  if [[ -L "$source" ]]; then
    dir="$(cd "$(dirname "$source")" && cd "$(dirname "$(readlink "$source")")" && pwd)"
  else
    dir="$(cd "$(dirname "$source")" && pwd)"
  fi

  if [[ -f "$dir/../package.json" ]]; then
    cd "$dir/.." && pwd
    return
  fi
  if [[ -f "$dir/package.json" ]]; then
    printf '%s\n' "$dir"
    return
  fi

  printf '%s\n' "$DEFAULT_ROOT"
}

ROOT="$(resolve_root)"
if [[ ! -f "$ROOT/package.json" ]]; then
  printf 'browser-session-ctl: project not found at %s\n' "$ROOT" >&2
  exit 1
fi

cd "$ROOT"
exec npm run --silent ctl -- "$@"
